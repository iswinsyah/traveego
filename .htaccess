# KONFIGURASI HTACCESS UNTUK HOSTINGER SHARED HOSTING (APACHE / LITESPEED)
RewriteEngine On
RewriteBase /

# 0. PROTEKSI KEAMANAN DARI PENYUSUP (BLOKIR AKSES WEB KE FOLDER DATA & FILE SENSITIF)
RewriteRule ^data(/.*)?$ - [F,L]
<FilesMatch "^(\.env|\.git|.*\.(sql|log|md))$">
    Require all denied
</FilesMatch>

# 1. Rute Live Tracking Pelanggan: /trip/TRX-XXXX
RewriteRule ^trip/([A-Za-z0-9\-]+)/?$ trip.html?code=$1 [L,QSA]

# 2. Rute PWA Sopir: /driver
RewriteRule ^driver/?$ driver.html [L]

# 3. Rute Dashboard Admin: /admin (Dilindungi Login WordPress: admin / admin@traveego)
RewriteRule ^admin/?$ admin.php [L,QSA]

# 3b. Rute Dashboard Crew AI: /crew-ai (Dilindungi Login: winsyah / Khilafet@1924)
RewriteRule ^crew-ai/?$ crew-ai.php [L,QSA]

# 3c. Rute Artikel Blog SEO: /blog/slug-artikel (Mbak Maya)
RewriteRule ^blog/([A-Za-z0-9\-]+)/?$ post.php?slug=$1 [L,QSA]

# 3d. Rute Landing Page Rute Drop Off (Bung Kevin)
RewriteCond %{DOCUMENT_ROOT}/data/generated_pages/$1.json -f [OR]
RewriteCond %{DOCUMENT_ROOT}/../data/generated_pages/$1.json -f
RewriteRule ^([A-Za-z0-9\-]+)/?$ page.php?slug=$1 [L,QSA]

# 4. Izinkan akses langsung ke folder api, uploads, dan file statis yang ada
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Cek apakah file yang diminta ada di dalam subfolder public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(.+)$ public/$1 [L]

# 6. Fallback Halaman Depan
RewriteCond %{DOCUMENT_ROOT}/public/index.html -f
RewriteRule ^$ public/index.html [L]
RewriteRule ^$ index.html [L]

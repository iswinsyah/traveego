# PORT SERVER
PORT=3000
NODE_ENV=development

# DATABASE MYSQL LOKAL (XAMPP / LARAGON)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traveego_db

# REKENING ADMIN UNTUK SETORAN KOMISI SOPIR (PASCA-BAYAR)
ADMIN_BANK_NAME=BCA
ADMIN_BANK_ACCOUNT=1234567890
ADMIN_BANK_HOLDER=Traveego Operasional

# OLLAMA LOKAL (UNTUK CS AI SIMULASI)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# BASE URL (DI KOMPUTER LOKAL: localhost:3000, DI VPS: https://drop-off.online)
BASE_URL=http://localhost:3000
